# Supply-chain hardening — see afa-brand/ARCHITECTURE.md D2.
#
# A dependency's install script runs arbitrary code with your credentials and
# write access to this tree, before you have read a single line of it. That is
# the cheapest way into a build, and it is used. Turning it off is one line.
#
# When a package genuinely needs its script (native binaries: sharp, esbuild,
# workerd), allow it explicitly and by exact version, the way afa-site's
# package.json "allowScripts" block does — never by turning this back on.
ignore-scripts=true

# Fail on a tarball whose integrity does not match the lockfile rather than
# retrying against a possibly-poisoned mirror.
audit=true
fund=false
